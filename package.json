{
  "name": "apsco-commerce",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "npm run start:dev -w api",
    "build": "npm run build -w api",
    "typecheck": "npm run typecheck -w api",
    "test": "npm test -w api",
    "db:up": "docker compose -f infra/compose.yaml up -d db",
    "db:down": "docker compose -f infra/compose.yaml down",
    "db:migrate": "npm run migration:run -w api",
    "db:rollback": "npm run migration:revert -w api"
  }
}
